#!/usr/bin/env bash
# Full sync: clone missing repos and fetch existing ones through llm-git-guard,
# repointing any drifted origin, then register everything with Paseo. Run daily
# from cron. The live counterpart that picks up brand-new repos within ~a minute
# (instead of waiting for this run) is gh-sync-watch.
set -uo pipefail

# shellcheck source=gh-sync-lib.sh
source "$(dirname "$(readlink -f "$0")")/gh-sync-lib.sh"

LOG_FILE="$LOG_DIR/sync.log"

{
    echo "=== $(date -Iseconds) gh-sync (proxy=$PROXY) start ==="

    list_remote_repos |
    while IFS=$'\t' read -r owner name; do
        [[ -z "$owner" || -z "$name" ]] && continue
        sync_repo "$owner" "$name"
    done

    echo "--- registering repos with paseo ---"
    "$HOME/.local/bin/paseo-register-repos" || echo "paseo-register-repos failed (non-fatal)"

    echo "=== $(date -Iseconds) gh-sync done ==="
} 2>&1 | tee -a "$LOG_FILE"
