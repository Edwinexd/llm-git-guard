#!/usr/bin/env bash
# Live repo watcher: polls the GitHub repo list and clones any repo that exists
# on GitHub but not yet on disk, so a repo created on GitHub shows up under
# ~/repos within ~a minute instead of waiting for the 04:00 cron full sync.
#
# Detection is poll-based on purpose. GitHub has no push/stream feed for "repo
# created" on a personal account (that needs a GitHub App webhook + a public
# receiver); the repo list is server-cached ~60s, so polling faster buys little.
# "New" == present in the remote list but missing on disk, so disk is the only
# state we keep: no snapshot file to drift, deletions self-heal, failed clones
# simply retry next poll. Existing checkouts are never touched here; fetch/
# repoint of those stays with the daily gh-sync.
#
# Env:
#   GH_SYNC_WATCH_INTERVAL   seconds between polls (default 65)
set -uo pipefail

# shellcheck source=gh-sync-lib.sh
source "$(dirname "$(readlink -f "$0")")/gh-sync-lib.sh"

LOG_FILE="$LOG_DIR/watch.log"
INTERVAL="${GH_SYNC_WATCH_INTERVAL:-65}"
HEARTBEAT_EVERY=55   # log a liveness line roughly once an hour at 65s cadence

log() { printf '%s %s\n' "$(date -Iseconds)" "$*" | tee -a "$LOG_FILE"; }

running=1
trap 'running=0' TERM INT

log "gh-sync-watch start (interval=${INTERVAL}s proxy=$PROXY repos=$REPOS_DIR)"

polls=0
while [[ "$running" == 1 ]]; do
    if remote=$(list_remote_repos 2>>"$LOG_FILE"); then
        new=0 present=0 total=0
        while IFS=$'\t' read -r owner name; do
            [[ -z "$owner" || -z "$name" ]] && continue
            total=$((total + 1))
            if [[ -d "$REPOS_DIR/$owner/$name/.git" ]]; then
                present=$((present + 1))
                continue
            fi
            new=$((new + 1))
            log "new repo: $owner/$name -> cloning"
            while IFS= read -r line; do log "  $line"; done \
                < <(clone_repo "$owner" "$name" 2>&1)
            [[ -d "$REPOS_DIR/$owner/$name/.git" ]] && present=$((present + 1))
        done <<< "$remote"

        if (( new > 0 )); then
            log "registering $new new repo(s) with paseo"
            PASEO_REGISTER_NO_START=1 "$HOME/.local/bin/paseo-register-repos" \
                >/dev/null 2>&1 || log "paseo-register-repos failed (non-fatal)"
        fi

        polls=$((polls + 1))
        if (( polls % HEARTBEAT_EVERY == 1 )); then
            log "alive: $present/$total accessible repos present locally"
        fi
    else
        log "repo list fetch failed; retrying in ${INTERVAL}s"
    fi

    # Interruptible sleep so SIGTERM stops us within ~1s instead of a full cycle.
    for ((i = 0; i < INTERVAL && running == 1; i++)); do sleep 1; done
done

log "gh-sync-watch stop"
